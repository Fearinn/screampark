{
  "name": "screampark",
  "version": "1.0.0",
  "description": "",
  "main": "screampark.js",
  "scripts": {
    "build:ts": "tsc",
    "build:scss": "sass --no-source-map src/screampark.scss screampark.css",
    "watch:ts": "tsc --watch",
    "watch:scss": "sass --watch --no-source-map src/screampark.scss screampark.css",
    "watch": "pnpm run /^watch:.*/",
    "build": "pnpm run build:ts && pnpm run build:scss"
  },
  "author": "Matheus Gomes",
  "license": "MIT",
  "devDependencies": {
    "sass": "^1",
    "typescript": "^5",
    "bga-help": "thoun/bga-help#1.0.0",
    "bga-zoom": "thoun/bga-zoom#1.0.4"
  }
}
